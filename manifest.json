{
  "manifest_version": 3,
  "name": "Instagram Scroll Torture",
  "version": "2.6.0",
  "description": "Bloqueo progresivo e ineludible para Instagram",
  "browser_specific_settings": {
    "gecko": {
      "id": "ig-torture@maxicabrera.dev"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
